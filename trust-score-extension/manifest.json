{
  "manifest_version": 3,
  "name": "Token trust score",
  "version": "0.1.0",
  "description": "Detects a token on a DEX page and runs the Token trust score scan.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.gopluslabs.io/*",
    "https://api.coingecko.com/*",
    "https://api.insightx.network/*",
    "https://api.twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Token trust score",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://dexscreener.com/*",
        "https://www.dexscreener.com/*",
        "https://app.uniswap.org/*",
        "https://gmgn.ai/*",
        "https://birdeye.so/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content.css"],
      "matches": [
        "https://dexscreener.com/*",
        "https://www.dexscreener.com/*",
        "https://app.uniswap.org/*",
        "https://gmgn.ai/*",
        "https://birdeye.so/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
